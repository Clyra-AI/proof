{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://axym.dev/schemas/v1/governance/action-contract-evidence-packet.schema.json",
  "title":"Axym governed Action Contract evidence packet",
  "type":"object", "additionalProperties":false,
  "required":["schema_id","schema_version","packet_id","contract","evidence","completeness","source_digests"],
  "properties":{"schema_id":{"const":"https://axym.dev/schemas/v1/governance/action-contract-evidence-packet.schema.json"},"schema_version":{"const":"v1"},"packet_id":{"type":"string","minLength":1},"contract":{"$ref":"action-contract-register.schema.json#/$defs/contract"},"evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["kind","ref","occurred_at","contract_ref","provenance"],"properties":{"kind":{"type":"string","minLength":1},"ref":{"$ref":"action-contract-register.schema.json#/$defs/ref"},"occurred_at":{"type":"string","format":"date-time"},"contract_ref":{"$ref":"action-contract-register.schema.json#/$defs/ref"},"attributes":{"type":"object","additionalProperties":{"type":"string"}},"provenance":{"$ref":"action-contract-register.schema.json#/$defs/ref"}}}},"completeness":{"enum":["complete","partial","gap"]},"reason_codes":{"type":"array","items":{"type":"string"}},"source_digests":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"signature":{"type":"object","additionalProperties":false,"required":["alg","key_id","sig","signed_digest"],"properties":{"alg":{"const":"ed25519"},"key_id":{"type":"string"},"sig":{"type":"string"},"signed_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"axis_states":{"type":"object","additionalProperties":{"enum":["present","missing","unknown","gap"]}}}
}
