{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Clyra-AI/proof/schemas/v1/proof-record-v1.schema.json",
  "type": "object",
  "required": [
    "record_id",
    "record_version",
    "timestamp",
    "source",
    "source_product",
    "record_type",
    "event",
    "controls",
    "integrity"
  ],
  "$defs": {
    "parent_kind": {
      "anyOf": [
        { "enum": ["trace", "run", "session", "intent", "policy", "agent", "evidence"] },
        { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*)+$" }
      ]
    },
    "entity_kind": {
      "anyOf": [
        { "enum": ["agent", "tool", "resource", "policy", "run", "trace", "delegation", "evidence"] },
        { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*)+$" }
      ]
    },
    "edge_kind": {
      "anyOf": [
        { "enum": ["delegates_to", "calls", "governed_by", "targets", "derived_from", "emits_evidence"] },
        { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*)+$" }
      ]
    },
    "parent_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "#/$defs/parent_kind" },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "description": "SHA-256 digest; legacy additive values remain accepted for hash compatibility" },
        "schema_id": { "description": "Producing schema identifier; legacy additive values remain accepted" },
        "schema_version": { "description": "Producing schema version; legacy additive values remain accepted" },
        "source_product": { "description": "Producing product; legacy additive values remain accepted" }
      }
    },
    "entity_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "#/$defs/entity_kind" },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "description": "SHA-256 digest; legacy additive values remain accepted for hash compatibility" },
        "schema_id": { "description": "Producing schema identifier; legacy additive values remain accepted" },
        "schema_version": { "description": "Producing schema version; legacy additive values remain accepted" },
        "source_product": { "description": "Producing product; legacy additive values remain accepted" }
      }
    },
    "endpoint_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "description": "SHA-256 digest; legacy additive values remain accepted for hash compatibility" },
        "schema_id": { "description": "Producing schema identifier; legacy additive values remain accepted" },
        "schema_version": { "description": "Producing schema version; legacy additive values remain accepted" },
        "source_product": { "description": "Producing product; legacy additive values remain accepted" }
      }
    },
    "relationship_envelope": {
      "type": "object",
      "properties": {
        "parent_ref": { "$ref": "#/$defs/parent_ref" },
        "entity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entity_ref" }
        },
        "policy_ref": {
          "type": "object",
          "properties": {
            "policy_id": { "type": "string", "minLength": 1 },
            "policy_version": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
            "matched_rule_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "agent_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["identity", "role"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "enum": ["requester", "delegator", "delegate"] }
            }
          }
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["kind", "from", "to"],
            "properties": {
              "kind": { "$ref": "#/$defs/edge_kind" },
              "from": { "$ref": "#/$defs/endpoint_ref" },
              "to": { "$ref": "#/$defs/endpoint_ref" }
            }
          }
        },
        "parent_record_id": { "type": "string", "minLength": 1 },
        "related_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "related_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "agent_lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent_id"],
            "properties": {
              "agent_id": { "type": "string", "minLength": 1 },
              "delegated_by": { "type": "string", "minLength": 1 },
              "delegation_record_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "record_version": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "source_product": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string" },
    "record_type": { "type": "string", "minLength": 1 },
    "event": { "type": "object" },
    "controls": { "type": "object" },
    "metadata": { "type": "object" },
    "relationship": { "$ref": "#/$defs/relationship_envelope" },
    "relations": { "$ref": "#/$defs/relationship_envelope" },
    "integrity": {
      "type": "object",
      "required": ["record_hash"],
      "properties": {
        "record_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "previous_record_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signing_key_id": { "type": "string" },
        "signature": { "type": "string", "pattern": "^(base64|cosign):.+" }
      }
    }
  }
}
