{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Clyra-AI/proof/schemas/v1/proof-record-v1.schema.json",
  "type": "object",
  "required": [
    "record_id",
    "record_version",
    "timestamp",
    "source",
    "source_product",
    "record_type",
    "event",
    "controls",
    "integrity"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "record_version": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "source_product": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string" },
    "record_type": { "type": "string", "minLength": 1 },
    "event": { "type": "object" },
    "controls": { "type": "object" },
    "metadata": { "type": "object" },
    "relations": {
      "type": "object",
      "properties": {
        "parent_record_id": { "type": "string", "minLength": 1 },
        "related_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "related_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "policy_ref": {
          "type": "object",
          "properties": {
            "policy_id": { "type": "string", "minLength": 1 },
            "policy_version": { "type": "string", "minLength": 1 },
            "policy_digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
          }
        },
        "agent_lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent_id"],
            "properties": {
              "agent_id": { "type": "string", "minLength": 1 },
              "delegated_by": { "type": "string", "minLength": 1 },
              "delegation_record_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["record_hash"],
      "properties": {
        "record_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "previous_record_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signing_key_id": { "type": "string" },
        "signature": { "type": "string", "pattern": "^(base64|cosign):.+" }
      }
    }
  }
}
